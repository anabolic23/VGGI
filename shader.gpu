// Vertex shader 
const vertexShaderSource = `
attribute vec3 vertex;
attribute vec3 normal;

uniform mat4 ModelViewMatrix;          // model-view (eye) matrix
uniform mat4 ModelViewProjectionMatrix;
uniform mat3 NormalMatrix;             // inverse-transpose of ModelViewMatrix upper-left 3x3

varying vec3 vNormalEye;               // normal in eye space
varying vec3 vPositionEye;             // position in eye space

void main() {
    vec4 posEye = ModelViewMatrix * vec4(vertex, 1.0);
    vPositionEye = posEye.xyz;
    vNormalEye = normalize(NormalMatrix * normal);
    gl_Position = ModelViewProjectionMatrix * vec4(vertex, 1.0);
}`;

// Fragment shader (Phong shading per-pixel)
const fragmentShaderSource = `
#ifdef GL_FRAGMENT_PRECISION_HIGH
  precision highp float;
#else
  precision mediump float;
#endif

varying vec3 vNormalEye;
varying vec3 vPositionEye;

uniform vec3 uLightPosEye;       // light position in eye space
uniform vec3 uAmbientColor;      // ambient light color/intensity
uniform vec3 uLightColor;        // diffuse/specular light color
uniform float uShininess;        // specular shininess
uniform vec3 uSpecularColor;     // specular color (or intensity)
uniform vec3 uMaterialDiffuse;   // material diffuse color

void main() {
    vec3 N = normalize(vNormalEye);
    vec3 L = normalize(uLightPosEye - vPositionEye);

    // viewer direction: use approximation (0,0,1) in eye space as allowed by hint
    vec3 V = normalize(vec3(0.0, 0.0, 1.0));

    float lambert = max(dot(N, L), 0.0);

    // Blinn-Phong (using half-vector) or classic Phong reflect() - we'll use reflect()
    vec3 R = reflect(-L, N);
    float spec = 0.0;
    if (lambert > 0.0) {
        spec = pow(max(dot(R, V), 0.0), uShininess);
    }

    vec3 ambient = uAmbientColor * uMaterialDiffuse;
    vec3 diffuse = uLightColor * uMaterialDiffuse * lambert;
    vec3 specular = uSpecularColor * spec;

    vec3 color = ambient + diffuse + specular;
    gl_FragColor = vec4(color, 1.0);
}`;